+import {
+  Body,
+  Controller,
+  Get,
+  Param,
+  Post,
+  Query,
+} from '@nestjs/common';
+import {
+  ApiBearerAuth,
+  ApiBadRequestResponse,
+  ApiCreatedResponse,
+  ApiForbiddenResponse,
+  ApiNotFoundResponse,
+  ApiOkResponse,
+  ApiOperation,
+  ApiTags,
+  ApiUnauthorizedResponse,
+} from '@nestjs/swagger';
+import { AuthUser } from '../auth/types/auth-user';
+import { CurrentUser } from '../common/decorators/current-user.decorator';
+import { uuidPipe } from '../common/pipes/uuid.pipe';
+import { CreateHistoryDto } from './dto/create-history.dto';
+import { HistoryQueryDto } from './dto/history-query.dto';
+import { HistoryStatsDto } from './dto/history-stats.dto';
+import { FocusHistory } from './entities/focus-history.entity';
+import { HistoryService } from './history.service';
+
+@ApiTags('history')
+@ApiBearerAuth('access-token')
+@ApiUnauthorizedResponse({ description: 'UNAUTHORIZED — нет или недействителен JWT' })
+@Controller('history')
+export class HistoryController {
+  constructor(private readonly history: HistoryService) {}
+
+  @Post()
+  @ApiOperation({
+    summary: 'Сохранить результат Pomodoro-сессии',
+    description:
+      'Вызывается клиентом после завершения или отмены фокус-фазы. ' +
+      'Одна запись принадлежит текущему пользователю.',
+  })
+  @ApiCreatedResponse({ type: FocusHistory })
+  @ApiBadRequestResponse({ description: 'VALIDATION_ERROR или BAD_REQUEST' })
+  @ApiNotFoundResponse({ description: 'TASK_NOT_FOUND' })
+  @ApiForbiddenResponse({ description: 'NOT_IN_ROOM' })
+  create(@CurrentUser() user: AuthUser, @Body() dto: CreateHistoryDto): Promise<FocusHistory> {
+    return this.history.create(user.id, dto);
+  }
+
+  @Get('stats')
+  @ApiOperation({ summary: 'Статистика Pomodoro-сессий за период' })
+  @ApiOkResponse({ type: HistoryStatsDto })
+  getStats(
+    @CurrentUser() user: AuthUser,
+    @Query() query: HistoryQueryDto,
+  ): Promise<HistoryStatsDto> {
+    return this.history.getStats(user.id, query);
+  }
+
+  @Get()
+  @ApiOperation({ summary: 'История Pomodoro-сессий' })
+  @ApiOkResponse({
+    schema: {
+      example: {
+        items: [],
+        total: 0,
+      },
+    },
+  })
+  findAll(
+    @CurrentUser() user: AuthUser,
+    @Query() query: HistoryQueryDto,
+  ): Promise<{ items: FocusHistory[]; total: number }> {
+    return this.history.findAll(user.id, query);
+  }
+
+  @Get(':id')
+  @ApiOperation({ summary: 'Одна запись истории' })
+  @ApiOkResponse({ type: FocusHistory })
+  @ApiNotFoundResponse({ description: 'HISTORY_NOT_FOUND' })
+  findOne(
+    @CurrentUser() user: AuthUser,
+    @Param('id', uuidPipe) id: string,
+  ): Promise<FocusHistory> {
+    return this.history.findOne(user.id, id);
+  }
+}
