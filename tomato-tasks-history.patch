+++ b/src/history/history.service.ts
@@ -0,0 +1,124 @@
+import { Injectable } from '@nestjs/common';
+import { InjectRepository } from '@nestjs/typeorm';
+import { Repository, SelectQueryBuilder } from 'typeorm';
+import { RoomMember } from '../rooms/entities/room-member.entity';
+import { Task } from '../tasks/entities/task.entity';
+import { CreateHistoryDto } from './dto/create-history.dto';
+import { HistoryQueryDto } from './dto/history-query.dto';
+import { HistoryStatsDto } from './dto/history-stats.dto';
+import { FocusHistory } from './entities/focus-history.entity';
+import { historyErrors } from './history.errors';
+
+@Injectable()
+export class HistoryService {
+  constructor(
+    @InjectRepository(FocusHistory)
+    private readonly history: Repository<FocusHistory>,
+    @InjectRepository(Task)
+    private readonly tasks: Repository<Task>,
+    @InjectRepository(RoomMember)
+    private readonly roomMembers: Repository<RoomMember>,
+  ) {}
+
+  async create(userId: string, dto: CreateHistoryDto): Promise<FocusHistory> {
+    const startedAt = new Date(dto.startedAt);
+    const endedAt = new Date(dto.endedAt);
+    const elapsedSeconds = Math.floor((endedAt.getTime() - startedAt.getTime()) / 1000);
+
+    if (
+      !Number.isFinite(elapsedSeconds) ||
+      elapsedSeconds < 1 ||
+      dto.focusedSeconds > dto.plannedDurationSeconds ||
+      dto.focusedSeconds > elapsedSeconds + 1
+    ) {
+      throw historyErrors.invalidInterval();
+    }
+
+    let taskTitle: string | null = null;
+    if (dto.taskId) {
+      const task = await this.tasks.findOneBy({ id: dto.taskId, userId });
+      if (!task) throw historyErrors.taskNotFound();
+      taskTitle = task.title;
+    }
+
+    if (dto.roomId) {
+      const membership = await this.roomMembers.findOneBy({ roomId: dto.roomId, userId });
+      if (!membership) throw historyErrors.roomMembershipNotFound();
+    }
+
+    return this.history.save(
+      this.history.create({
+        userId,
+        taskId: dto.taskId ?? null,
+        taskTitle,
+        roomId: dto.roomId ?? null,
+        pomodoroSessionId: dto.pomodoroSessionId ?? null,
+        status: dto.status,
+        plannedDurationSeconds: dto.plannedDurationSeconds,
+        focusedSeconds: dto.focusedSeconds,
+        startedAt,
+        endedAt,
+      }),
+    );
+  }
+
+  async findAll(userId: string, query: HistoryQueryDto): Promise<{ items: FocusHistory[]; total: number }> {
+    const builder = this.filteredQuery(userId, query);
+    const [items, total] = await builder
+      .orderBy('history.startedAt', 'DESC')
+      .addOrderBy('history.id', 'DESC')
+      .skip(query.offset ?? 0)
+      .take(query.limit ?? 50)
+      .getManyAndCount();
+    return { items, total };
+  }
+
+  async findOne(userId: string, historyId: string): Promise<FocusHistory> {
+    const record = await this.history.findOneBy({ id: historyId, userId });
+    if (!record) throw historyErrors.recordNotFound();
+    return record;
+  }
+
+  async getStats(userId: string, query: Pick<HistoryQueryDto, 'from' | 'to'> = {}): Promise<HistoryStatsDto> {
+    const builder = this.filteredQuery(userId, query);
+    const row = await builder
+      .select('COUNT(*)', 'totalSessions')
+      .addSelect("COUNT(*) FILTER (WHERE history.status = 'completed')", 'completedSessions')
+      .addSelect("COUNT(*) FILTER (WHERE history.status = 'cancelled')", 'cancelledSessions')
+      .addSelect('COALESCE(SUM(history.focusedSeconds), 0)', 'totalFocusedSeconds')
+      .getRawOne<{
+        totalSessions: string;
+        completedSessions: string;
+        cancelledSessions: string;
+        totalFocusedSeconds: string;
+      }>();
+
+    const totalSessions = Number(row?.totalSessions ?? 0);
+    const completedSessions = Number(row?.completedSessions ?? 0);
+    const cancelledSessions = Number(row?.cancelledSessions ?? 0);
+    const totalFocusedSeconds = Number(row?.totalFocusedSeconds ?? 0);
+
+    return {
+      totalSessions,
+      completedSessions,
+      cancelledSessions,
+      totalFocusedSeconds,
+      totalFocusedMinutes: Math.floor(totalFocusedSeconds / 60),
+      averageFocusedSeconds:
+        totalSessions > 0 ? Math.round(totalFocusedSeconds / totalSessions) : 0,
+    };
+  }
+
+  private filteredQuery(
+    userId: string,
+    query: Pick<HistoryQueryDto, 'status' | 'from' | 'to'>,
+  ): SelectQueryBuilder<FocusHistory> {
+    const builder = this.history.createQueryBuilder('history').where('history.userId = :userId', {
+      userId,
+    });
+    if (query.status) builder.andWhere('history.status = :status', { status: query.status });
+    if (query.from) builder.andWhere('history.startedAt >= :from', { from: query.from });
+    if (query.to) builder.andWhere('history.startedAt < :to', { to: query.to });
+    return builder;
+  }
+}
