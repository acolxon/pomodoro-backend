+import { Injectable } from '@nestjs/common';
+import { InjectRepository } from '@nestjs/typeorm';
+import { Repository } from 'typeorm';
+import { CreateTaskDto } from './dto/create-task.dto';
+import { UpdateTaskDto } from './dto/update-task.dto';
+import { Task, TaskStatus } from './entities/task.entity';
+import { isActiveTaskCollision, taskErrors } from './tasks.errors';
+
+@Injectable()
+export class TasksService {
+  constructor(@InjectRepository(Task) private readonly tasks: Repository<Task>) {}
+
+  async create(userId: string, dto: CreateTaskDto): Promise<Task> {
+    const task = this.tasks.create({
+      userId,
+      title: dto.title,
+      description: dto.description?.trim() || null,
+      status: TaskStatus.Todo,
+      completedAt: null,
+    });
+    return this.tasks.save(task);
+  }
+
+  findAll(userId: string, status?: TaskStatus): Promise<Task[]> {
+    return this.tasks.find({
+      where: status ? { userId, status } : { userId },
+      order: { createdAt: 'DESC', id: 'DESC' },
+    });
+  }
+
+  async findOne(userId: string, taskId: string): Promise<Task> {
+    const task = await this.tasks.findOneBy({ id: taskId, userId });
+    if (!task) throw taskErrors.notFound();
+    return task;
+  }
+
+  async update(userId: string, taskId: string, dto: UpdateTaskDto): Promise<Task> {
+    const task = await this.findOne(userId, taskId);
+    if (dto.title !== undefined) task.title = dto.title;
+    if (dto.description !== undefined) task.description = dto.description;
+    if (dto.status !== undefined) {
+      task.status = dto.status;
+      task.completedAt = dto.status === TaskStatus.Completed ? new Date() : null;
+    }
+
+    try {
+      return await this.tasks.save(task);
+    } catch (error) {
+      if (isActiveTaskCollision(error)) throw taskErrors.activeTaskExists();
+      throw error;
+    }
+  }
+
+  async remove(userId: string, taskId: string): Promise<void> {
+    const task = await this.findOne(userId, taskId);
+    await this.tasks.remove(task);
+  }
+}
diff --git a/test/tasks-history.e2e-spec.ts b/test/tasks-history.e2e-spec.ts
new file mode 100644
index 0000000..9b2607c
--- /dev/null
+++ b/test/tasks-history.e2e-spec.ts
@@ -0,0 +1,149 @@
+import { INestApplication } from '@nestjs/common';
+import request from 'supertest';
+import { DataSource } from 'typeorm';
+import { createTestApp, RegisteredUser, registerUser, resetData } from './utils/test-app';
+
+describe('Tasks and History (e2e)', () => {
+  let app: INestApplication;
+  let ds: DataSource;
+  const http = () => request(app.getHttpServer());
+  const as = (user: RegisteredUser) => ({ Authorization: `Bearer ${user.token}` });
+
+  beforeAll(async () => {
+    ({ app, dataSource: ds } = await createTestApp());
+  });
+
+  beforeEach(async () => {
+    await resetData(ds);
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('создаёт личные задачи и не позволяет иметь две активные задачи', async () => {
+    const user = await registerUser(app);
+    const first = await http()
+      .post('/tasks')
+      .set(as(user))
+      .send({ title: 'Finish API', description: 'Tasks and history' })
+      .expect(201);
+
+    expect(first.body).toMatchObject({
+      userId: user.id,
+      title: 'Finish API',
+      status: 'todo',
+      completedAt: null,
+    });
+
+    await http()
+      .patch(`/tasks/${first.body.id}`)
+      .set(as(user))
+      .send({ status: 'in_progress' })
+      .expect(200);
+
+    const second = await http()
+      .post('/tasks')
+      .set(as(user))
+      .send({ title: 'Write tests' })
+      .expect(201);
+
+    const conflict = await http()
+      .patch(`/tasks/${second.body.id}`)
+      .set(as(user))
+      .send({ status: 'in_progress' })
+      .expect(409);
+    expect(conflict.body.code).toBe('ACTIVE_TASK_EXISTS');
+
+    const completed = await http()
+      .patch(`/tasks/${first.body.id}`)
+      .set(as(user))
+      .send({ status: 'completed' })
+      .expect(200);
+    expect(completed.body.completedAt).toEqual(expect.any(String));
+  });
+
+  it('изолирует задачи между пользователями', async () => {
+    const alice = await registerUser(app, 'alice');
+    const bob = await registerUser(app, 'bob');
+    const task = await http().post('/tasks').set(as(alice)).send({ title: 'Private task' }).expect(201);
+
+    const response = await http().get(`/tasks/${task.body.id}`).set(as(bob)).expect(404);
+    expect(response.body.code).toBe('TASK_NOT_FOUND');
+  });
+
+  it('сохраняет историю фокус-сессии и считает статистику', async () => {
+    const user = await registerUser(app);
+    const task = await http().post('/tasks').set(as(user)).send({ title: 'Build Tomato' }).expect(201);
+
+    const record = await http()
+      .post('/history')
+      .set(as(user))
+      .send({
+        taskId: task.body.id,
+        status: 'completed',
+        plannedDurationSeconds: 1500,
+        focusedSeconds: 1480,
+        startedAt: '2026-11-14T10:00:00.000Z',
+        endedAt: '2026-11-14T10:25:00.000Z',
+      })
+      .expect(201);
+
+    expect(record.body).toMatchObject({
+      userId: user.id,
+      taskId: task.body.id,
+      taskTitle: 'Build Tomato',
+      status: 'completed',
+      plannedDurationSeconds: 1500,
+      focusedSeconds: 1480,
+    });
+
+    const list = await http().get('/history?limit=10').set(as(user)).expect(200);
+    expect(list.body.total).toBe(1);
+    expect(list.body.items).toHaveLength(1);
+
+    const stats = await http().get('/history/stats').set(as(user)).expect(200);
+    expect(stats.body).toMatchObject({
+      totalSessions: 1,
+      completedSessions: 1,
+      cancelledSessions: 0,
+      totalFocusedSeconds: 1480,
+      totalFocusedMinutes: 24,
+    });
+  });
+
+  it('не принимает невозможную длительность и не показывает чужую историю', async () => {
+    const alice = await registerUser(app, 'alice');
+    const bob = await registerUser(app, 'bob');
+    const created = await http()
+      .post('/history')
+      .set(as(alice))
+      .send({
+        status: 'cancelled',
+        plannedDurationSeconds: 1500,
+        focusedSeconds: 250,
+        startedAt: '2026-11-14T10:00:00.000Z',
+        endedAt: '2026-11-14T10:05:00.000Z',
+      })
+      .expect(201);
+
+    const invalid = await http()
+      .post('/history')
+      .set(as(alice))
+      .send({
+        status: 'completed',
+        plannedDurationSeconds: 1500,
+        focusedSeconds: 1500,
+        startedAt: '2026-11-14T10:00:00.000Z',
+        endedAt: '2026-11-14T10:05:00.000Z',
+      })
+      .expect(400);
+    expect(invalid.body.code).toBe('BAD_REQUEST');
+
+    const hidden = await http()
+      .get(`/history/${created.body.id}`)
+      .set(as(bob))
+      .expect(404);
+    expect(hidden.body.code).toBe('HISTORY_NOT_FOUND');
+  });
+});
